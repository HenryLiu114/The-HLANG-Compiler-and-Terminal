# Finds the largest Element
/defun largestElement (lis) {
    # Find Length
    /var len /mul /lis /?.

    # Use a default number to compare to
    /var largestNum -200000.

    
    # Loop
    /for i 0 /len 1 {
        # Get the item at index
        /var cur /div /i /lis.

        # Check if the number is greater than largest num
        /if (/gt /cur /largestNum) {/var largestNum /cur.}{}.
    }.
    
    # Return Statement
    /ret /largestNum.
}.

# Finds largest element with list
/usefun largestElement ([1,2,3,4,5,6,1]).

# Release and Print
/rel x.
/print /x.
